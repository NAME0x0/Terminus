{
  "name": "terminus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build --no-bundle",
    "bundle": "tauri build",
    "dev:frontend": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build:frontend": "vite build",
    "typecheck": "tsc --noEmit",
    "test:frontend": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:terminal-smoke": "cargo test --manifest-path src-tauri/Cargo.toml terminal_smoke_ -- --nocapture",
    "test": "npm run test:frontend && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@xterm/addon-clipboard": "^0.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.0",
    "vite": "^8.1.2",
    "vitest": "^4.1.10"
  }
}
